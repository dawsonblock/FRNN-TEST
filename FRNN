M_t = M[m_t]                           # Memory vector (Dm,)
bank_update_t = update_ema(bank, v_t)  # Update memory
v_long = bank.mean() or bank[m_t]      # Retrieve context
y_t = (M_t + α * v_long) @ Wrd + brd   # Fused readout

